{
  "name": "@local/paper-studio",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "An Overleaf-style LaTeX workspace inside the Harness Web GUI: project registry, file tree, highlighted editor with completion, live-streamed compiles with a terminal and problem list, and a live PDF.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "HANDOVER.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/compile.test.mjs test/http.test.mjs test/client.test.mjs",
    "test:render": "node test/render.smoke.mjs"
  }
}
