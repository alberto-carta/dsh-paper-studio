{
  "name": "@local/paper-studio",
  "version": "1.15.0",
  "private": true,
  "type": "module",
  "description": "An Overleaf-style LaTeX workspace inside the Harness Web GUI: project registry, file tree, highlighted editor with completion, live-streamed compiles with a terminal and problem list, and a live PDF.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "test": "PAPER_STUDIO_DATA_DIR=.test-data node --test --test-concurrency=1 test/compile.test.mjs test/http.test.mjs test/client.test.mjs",
    "test:render": "node test/render.smoke.mjs",
    "build:editor": "esbuild vendor/entry.js --bundle --format=esm --minify --target=es2020 --outfile=vendor/codemirror.js",
    "test:editor": "node test/editor.browser.mjs",
    "build:katex": "esbuild vendor/katex-entry.js --bundle --format=esm --minify --target=es2020 --outfile=vendor/katex.js"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@replit/codemirror-vim": "^6.4.0",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2",
    "katex": "^0.19.1",
    "@lezer/highlight": "^1.2.1"
  }
}
